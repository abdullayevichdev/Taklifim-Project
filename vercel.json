{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|images/|.*\\.(?:js|mjs|css|map|png|jpe?g|webp|avif|gif|svg|ico|woff2?|ttf|eot|json|xml|txt|mp3|ogg|wav|mp4|webm)$).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/payment/upload-receipt.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/telegram/webhook.ts": {
      "maxDuration": 20
    },
    "api/payment/status/[orderId].ts": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
